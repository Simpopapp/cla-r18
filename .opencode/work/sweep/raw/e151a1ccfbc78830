document.addEventListener("DOMContentLoaded", function () {
  jQuery(document).on("elementor/popup/show", function (event, id, instance) {
    if (id === 8373) {
      const input = document.querySelector("#elementor-popup-modal-8373 input[name='form-field-phone']");
      const hiddenInput = document.querySelector("#elementor-popup-modal-8373 #form-field-hiddenphone");

      if (!input || !hiddenInput) return;

      // Initialize intlTelInput with auto country detection
      const iti = window.intlTelInput(input, {
        loadUtils: () => import("https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/utils.js"),
        
        initialCountry: "auto",

        geoIpLookup: function (callback) {
          fetch("https://ipapi.co/json/")
            .then((res) => res.json())
            .then((data) => callback(data.country_code.toLowerCase()))
            .catch(() => callback("us"));
        },

        separateDialCode: true,
        preferredCountries: ["in", "gb", "us"],
        autoPlaceholder: "off",
        strictMode: true
      });

      input.setAttribute("placeholder", "");

      input.addEventListener("input", function () {
        hiddenInput.value = iti.getNumber();
      });
    }
  });
});

	
