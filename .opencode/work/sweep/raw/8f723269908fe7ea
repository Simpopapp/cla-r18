<script>
  jQuery(document).ready(function($){
      if ( typeof $.fn.owlCarousel === 'function' ) {
          var owl = $('.featured-slider');

          owl.owlCarousel({
              items: 2,
              loop: false, 
              
              nav: false,    
              dots: false,
              autoplay: false,
              autoplayTimeout: 3000,
              navText:["<div class='nav-btn prev-slide'></div>","<div class='nav-btn next-slide'></div>"],
              responsive:{
                  0:{ items:1 },
                  600:{ items:2 },
                  1000:{ items:2 }
              }
          });

          // Custom button triggers
          $('.custom-prev').click(function() {
              owl.trigger('prev.owl.carousel');
          });
          $('.custom-next').click(function() {
              owl.trigger('next.owl.carousel');
          });
          // Function to update disabled state
          function updateNavButtons(event) {
              var items     = event.item.count;   // total items
              var itemCount = event.page.size;    // items shown per page
              var index     = event.item.index;   // first visible item index
              // Disable prev if at first slide
              if (index === 0) {
                  $('.custom-prev').addClass('disabled');
              } else {
                  $('.custom-prev').removeClass('disabled');
              }

              // Disable next if at last slide
              if (index + itemCount >= items) {
                  $('.custom-next').addClass('disabled');
              } else {
                  $('.custom-next').removeClass('disabled');
              }
          }
          // Run once on init + every time slide changes
          owl.on('initialized.owl.carousel changed.owl.carousel', updateNavButtons);
          // ✅ Trigger update manually after init (in case event missed)
          owl.trigger('initialized.owl.carousel');
      }
  });
</script>
