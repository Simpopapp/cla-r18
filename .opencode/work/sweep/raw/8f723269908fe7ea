    document.querySelectorAll('.ez-toc-link').forEach(link => {
      link.addEventListener('click', function (e) {
        e.preventDefault();

        // Get the target id (decode URI for %E2 etc.)
        const targetId = decodeURIComponent(this.getAttribute('href').substring(1));
        const target = document.getElementById(targetId);

        if (!target) {
          console.warn('Target not found for:', targetId);
          return;
        }

        // Calculate offset position (50px from top)
        const offset = 50;
        const targetPosition = target.getBoundingClientRect().top + window.scrollY - offset;

        // Smooth scroll
        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });

        // Update the URL hash (optional)
        history.replaceState(null, null, '#' + targetId);
      });
    });
  });
