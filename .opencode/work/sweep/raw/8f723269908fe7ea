    document.addEventListener("DOMContentLoaded", function () {
        const stickyBtn = document.querySelector(".sticky-button-mobile");
        const footer = document.querySelector("footer"); // adjust if needed
        let chatFrame = null;
        if (!footer || !stickyBtn) return;
        // ------------------------------
        // Function to toggle active class
        // ------------------------------
        function toggleActive(add) {
            if (stickyBtn) {
                stickyBtn.classList.toggle("active", add);
            }
            if (chatFrame) {
                chatFrame.classList.toggle("active", add);
            }
        }
        // ------------------------------
        // Scroll handler
        // ------------------------------
        function onScroll() {
            const scrollTop =
                window.pageYOffset || document.documentElement.scrollTop;
            const footerTop = footer.getBoundingClientRect().top;
            const windowHeight = window.innerHeight;
            let shouldBeActive = scrollTop > 100;
            // Hide when footer is visible
            if (footerTop < windowHeight) {
                shouldBeActive = false;
            }
            toggleActive(shouldBeActive);
        }
        window.addEventListener("scroll", onScroll);
        // ------------------------------
        // Watch for #fc_frame injection
        // ------------------------------
        const observer = new MutationObserver(() => {
            const frame = document.querySelector("#fc_frame");
            if (frame) {
                chatFrame = frame;
                observer.disconnect(); // stop observing once found
                onScroll(); // sync state immediately
            }
        });
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
</script>
