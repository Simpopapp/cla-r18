/* ---- Header search ---- */
/* Filters a list of every page on the site, fetched once on first focus and
   held in memory. Filtering happens in the browser, so it responds on the
   first keystroke and does not put a request on the server per character. */
.impact-websites-iff-find{position:relative;flex:0 1 460px;margin-left:auto;z-index:9990}
.impact-websites-iff-find-in{display:flex;align-items:center;gap:8px;border:1px solid #D3DBE3;background:#FFFFFF;padding:0 12px}
.impact-websites-iff-find-in:focus-within{border-color:var(--iw-colour-primary)}
.impact-websites-iff-find-in svg{width:17px;height:17px;flex:0 0 auto;color:#6B7A88}
.impact-websites-iff-find input{flex:1 1 auto;min-width:0;border:0;outline:0;background:none;font:inherit;font-size:.98rem;padding:11px 0;color:var(--iw-colour-primary)}
.impact-websites-iff-find input::placeholder{color:#8494A2}
.impact-websites-iff-find-clear{border:0;background:none;padding:4px;cursor:pointer;color:#6B7A88;font:inherit;line-height:1;display:none}
.impact-websites-iff-find-clear:hover{color:var(--iw-colour-primary)}

.impact-websites-iff-find-out{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:9995;background:#FFFFFF;border:1px solid #D3DBE3;box-shadow:0 14px 34px rgba(13,33,54,.14);max-height:min(62vh,460px);overflow-y:auto;display:none}
.impact-websites-iff-find-out.impact-websites-iff-find-on{display:block}
.impact-websites-iff-find-out a{display:block;padding:10px 14px;text-decoration:none;color:var(--iw-colour-primary);border-bottom:1px solid #EDF1F4;font-size:.97rem;line-height:1.3}
.impact-websites-iff-find-out a:last-child{border-bottom:0}
.impact-websites-iff-find-out a mark{background:transparent;color:var(--iw-colour-tertiary);font-weight:700}
.impact-websites-iff-find-out a:hover,.impact-websites-iff-find-out a.impact-websites-iff-find-sel{background:var(--iw-colour-secondary)}
.impact-websites-iff-find-msg{padding:13px 14px;font-size:.94rem;color:#6B7A88}

