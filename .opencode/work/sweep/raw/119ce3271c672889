/* ---- Ad slots ---- */
/* Empty divs sit in page content inside .impact-websites-ads-band.
   The footer script decides whether to fill them, and collapses the
   whole band if AdSense returns no ad. min-height reserves the space
   before the ad arrives so nothing below moves when it loads -
   layout shift is the main cause of accidental clicks.
   The band padding is structural, not decoration: it guarantees real
   separation from the exercises and tests above and below. */
.impact-websites-ads-band{padding:56px 0}
/* No vertical margin here on purpose: .impact-websites-ads-band
   supplies the separation. Having both gave 166px of white above
   and below every ad. */
.impact-websites-ads-slot{display:block;width:100%;margin:0;clear:both;text-align:left}
.impact-websites-ads-slot[data-slot-type="below-title"]{min-height:280px}
.impact-websites-ads-slot[data-slot-type="mid-content"]{min-height:280px}
.impact-websites-ads-slot[data-slot-type="end-content"]{min-height:280px}
.impact-websites-ads-slot[data-slot-type="test-page"]{min-height:280px}
.impact-websites-ads-slot[data-slot-type="sidebar"]{min-height:600px;margin:0 0 2rem}
.impact-websites-ads-slot::before{content:"Advertisement";display:block;font-family:var(--iw-font-heading);font-size:.7rem;font-weight:700;line-height:1;letter-spacing:.14em;text-transform:uppercase;color:#6B7A88;margin-bottom:.5rem}
.impact-websites-ads-slot ins.adsbygoogle{display:block;width:100%}
.impact-websites-ads-band.impact-websites-ads-band-empty{display:none}
.impact-websites-ads-slot.impact-websites-ads-slot-empty{display:none}
body.impact-websites-ads-none .impact-websites-ads-band{display:none}
@media(min-width:768px){
  .impact-websites-ads-slot[data-slot-type="below-title"],
  .impact-websites-ads-slot[data-slot-type="mid-content"],
  .impact-websites-ads-slot[data-slot-type="end-content"],
  .impact-websites-ads-slot[data-slot-type="test-page"]{min-height:250px}
}
@media(max-width:660px){
  .impact-websites-ads-band{padding:40px 0}
}
@media print{
  .impact-websites-ads-band{display:none}
}

/* ---- Hero call to action, mobile ---- */
/* The hero CTA sits right of the H1 on wide screens and stacks below it
   under 940px. On phones it goes full width so it is a proper tap target
   rather than a small inline link. */
@media(max-width:660px){
