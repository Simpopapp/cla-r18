<script type="text/rocketlazyloadscript">
(function(){
  function dec(s){try{return JSON.parse(decodeURIComponent(escape(atob(s))));}catch(e){return null;}}
  function tidy(s){return (s||'').toLowerCase().replace(/[\u2018\u2019]/g,"'").replace(/[.,!?;:]+$/,'').replace(/\s+/g,' ').trim();}

  document.querySelectorAll('.impact-websites-iff-ex').forEach(function(form){
    var items=[].slice.call(form.querySelectorAll('.impact-websites-iff-ex-q'));
    var score=form.querySelector('.impact-websites-iff-ex-score');

    function clear(){
      items.forEach(function(li){
        li.removeAttribute('data-state');
        var fb=li.querySelector('.impact-websites-iff-ex-fb');
        if(fb){fb.hidden=true;}
        li.querySelectorAll('[data-mark]').forEach(function(n){n.removeAttribute('data-mark');});
        li.querySelectorAll('.impact-websites-iff-ex-sol').forEach(function(n){n.remove();});
      });
      if(score){score.textContent='';}
    }

    function markChoice(li,multi){
      var want=dec(li.getAttribute('data-answer'))||[];
      var opts=[].slice.call(li.querySelectorAll('.impact-websites-iff-ex-opts > li'));
      var picked=[];
      opts.forEach(function(o,i){
        var input=o.querySelector('input');
        if(input&&input.checked){picked.push(i);}
      });
      if(!picked.length){return null;}
      var ok = picked.length===want.length && picked.every(function(i){return want.indexOf(i)>-1;});
      opts.forEach(function(o,i){
        var isWant=want.indexOf(i)>-1, isPicked=picked.indexOf(i)>-1;
        if(isPicked&&isWant){o.setAttribute('data-mark','right');}
        else if(isPicked&&!isWant){o.setAttribute('data-mark','wrong');}
        else if(!isPicked&&isWant&&!ok){o.setAttribute('data-mark','right');}
      });
      return ok;
    }

    function markGap(li){
      var sets=dec(li.getAttribute('data-answer'))||[];
      var inputs=[].slice.call(li.querySelectorAll('input[type="text"]'));
      if(!inputs.some(function(i){return i.value.trim()!=='';})){return null;}
      var ok=true;
      inputs.forEach(function(input,i){
        var alts=(sets[i]||[]).map(tidy);
        var good=alts.indexOf(tidy(input.value))>-1;
        input.setAttribute('data-mark',good?'right':'wrong');
        if(!good){
          ok=false;
          var sol=document.createElement('span');
          sol.className='impact-websites-iff-ex-sol';
          sol.innerHTML='Answer: <strong>'+(sets[i]||[]).join('</strong> or <strong>')+'</strong>';
          (input.parentNode||li).appendChild(sol);
        }
      });
      return ok;
    }

    form.addEventListener('submit',function(e){
      e.preventDefault();
      clear();
      var right=0, answered=0;
      items.forEach(function(li){
        var mode=li.getAttribute('data-mode');
        var ok = mode==='gap' ? markGap(li) : markChoice(li, mode==='choice-multi');
        if(ok===null){return;}
        answered++;
        li.setAttribute('data-state', ok?'right':'wrong');
        if(ok){right++;}
        var fb=li.querySelector('.impact-websites-iff-ex-fb');
        if(fb&&fb.children.length){fb.hidden=false;}
      });
      if(score){
        score.textContent = answered ? right+' out of '+items.length+' correct'
                                     : 'Choose or type an answer first.';
      }
      var first=form.querySelector('[data-state="wrong"]');
      if(first){first.scrollIntoView({block:'center',behavior:
        window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});}
    });

    form.addEventListener('reset',function(){setTimeout(clear,0);});
  });
})();
</script>

