    document.addEventListener(
        "DOMContentLoaded",
        function() {
            hcLuckywheel.init({
                id: "luckywheel",
                config: function(callback) {
                    callback &&
                        callback(prizes);
                },
                mode: "both",
                getPrize: function(callback) {
                    var rand = randomIndex(prizes);
                    var chances = rand;
                    callback && callback([rand, chances]);
                },
                gotBack: function(data) {
                    var currentDate = new Date();

                    // Thêm 30 ngày vào thời gian hiện tại để lấy thời gian hết hạn của cookie
                    var expirationDate = new Date(currentDate.getTime() + (30 * 24 * 60 * 60 * 1000));

                    // Chuyển đổi thời gian hết hạn thành chuỗi định dạng GMT
                    var expiresGMT = expirationDate.toUTCString();

                    // Thiết lập cookie với thời gian hết hạn là 30 ngày
                    document.cookie = "rewardClaimed=true; expires=" + expiresGMT;
