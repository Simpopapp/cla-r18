            // Reset answers when switching slides
            function resetAnswers() {
                $('.toggle').prop('checked', false); // Uncheck all toggles
                $('.pratice-outer-answer').hide(); // Hide all answers
                $('#audio-controls').hide();
            }

            // Reset answers on navigation button click
            $('#nextButton, #prevButton').click(function () {
                resetAnswers();
                resetAll();
            });

            // Initialize: Hide all answers by default
            resetAnswers();
        });
        
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const popup = document.querySelector('.practice-popup-wrapper');
            const closeBtn = document.querySelector('.practice-image-popup-close');
            const img = document.getElementById('practicePopupImg');
            const desktopImg = 'https://www.gurully.com/assets-new/images/practice-page-popup.jpg';
            const mobileImg = 'https://www.gurully.com/assets-new/images/practice-page-popup-responsive.jpg';
            const STORAGE_KEY = 'practicePopupClosed';

            function updatePopupImage() {
                if (window.innerWidth < 497) {
                    img.src = mobileImg;
                    img.width = 496;
                    img.height = 650;
                } else {
                    img.src = desktopImg;
                    img.width = 893;
                    img.height = 463;
                }
            }

            // 🚫 If already closed, never show again
            if (localStorage.getItem(STORAGE_KEY) === 'true') {
                return;
            }

            // ⏳ Show popup after 5 seconds
            setTimeout(() => {
                popup.classList.add('active');
                updatePopupImage();
            }, 5000);

            // 🔄 Update image on resize
            window.addEventListener('resize', updatePopupImage);

            // ❌ Close popup & save state
            closeBtn.addEventListener('click', () => {
                popup.classList.remove('active');
                localStorage.setItem(STORAGE_KEY, 'true');
            });

            // Optional: close on overlay click
            popup.addEventListener('click', (e) => {
                if (e.target === popup) {
                    popup.classList.remove('active');
                    localStorage.setItem(STORAGE_KEY, 'true');
                }
            });
        });
    </script>
</body>
</html>