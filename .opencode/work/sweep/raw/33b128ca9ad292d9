    <script>
        let wavesurfer, record
        let scrollingWaveform = true
        let startTime = null

        function createWaveSurfer() {

            var currentURL = window.location.href;
            // Define the array of strings to check
            var conditions = [
                "read-aloud",
                "repeat-sentence",
                "describe-image",
                "respond-to-situation",
                "answer-short-question",
                "retell-lecture"
            ];

            // Check if any of the strings in the array are present in the current URL
            if (conditions.some(condition => currentURL.includes(condition))) {

                if (wavesurfer) {
                    wavesurfer.destroy()
                }
                wavesurfer = WaveSurfer.create({
                    container: '#mic',
                    waveColor: '#0d56f9',
                    progressColor: '#0d56f9',
                    height: 100,
                })

                record = wavesurfer.registerPlugin(RecordPlugin.create({ scrollingWaveform, renderRecordedAudio: false,scrollingWaveformWindow: 10, }))
                record.on('record-end', (blob) => {
                    const container = document.querySelector('#mic')
                    container.innerHTML = '';
                    const recordedUrl = URL.createObjectURL(blob)
                    // blobToDataURL(blob, function (url) {
                    // });
                   // alert("t6re");
                    $('#audio-player').attr('src', recordedUrl);

                    const wavesurfer = WaveSurfer.create({
                        container,
                        waveColor: '#fc8351',
                        progressColor: '#fc8351',
                        url: recordedUrl,
                        height: 100,
                    });
                    
                    const div = container.appendChild(document.createElement('div')); // Create a div and append it to the container
                    div.className = 'frequency-range-button'; // Optional: Add a class name to the div for styling
                    
                    const button = div.appendChild(document.createElement('button')); // Append the button to the div
                    button.type = 'button'; // Set the button type to "button"
                    button.textContent = 'Play';
                    button.onclick = () => wavesurfer.playPause();
                    wavesurfer.on('pause', () => (button.textContent = 'Play'));
                    wavesurfer.on('play', () => (button.textContent = 'Pause'));

                })
            }
            record.on('record-progress', (time) => {
                updateProgress(time)
            });
        }

        const progress = document.querySelector('#recording-start-time')
        const updateProgress = (time) => {
            // time will be in milliseconds, convert it to mm:ss format
            var startTime = Math.floor((time % 60000) / 1000); // seconds
            if(startTime >= 40) {
                stopNewRecording();
            }
            const formattedTime = [
                Math.floor((time % 3600000) / 60000), // minutes
                Math.floor((time % 60000) / 1000), // seconds
            ]
            .map((v) => (v < 10 ? '0' + v : v))
            .join(':')
            progress.textContent = formattedTime
        }
        
        const micSelect = document.querySelector('#mic-select')
        {
            // Mic selection
            RecordPlugin.getAvailableAudioDevices().then((devices) => {
                devices.forEach((device) => {
                const option = document.createElement('option')
                option.value = device.deviceId
                option.text = device.label || device.deviceId
                micSelect.appendChild(option)
                })
            })
        }

