    function BPhoneValidMainLayout() {
        // Validate Phone Number
        if ($.trim($('#PhoneNoM').val()) === '') {
            $('#PhoneNoM').focus().addClass('redborder');
            $('#spanPhoneNoM').show().html('Phone Number Required');
            return false;
        } else if (!/^\d{10}$/.test($('#PhoneNoM').val())) { // Ensure the phone number has exactly 10 digits
            $('#PhoneNoM').focus().addClass('redborder');
            $('#spanPhoneNoM').show().html('Invalid Phone Number');
            return false;
        } else {
            $('#PhoneNoM').removeClass('redborder');
            $('#spanPhoneNoM').hide();
        }

        return true;
    }

    function SendBLoginOTPM() {
        console.log('entered Mainlayout');
        var PhoneM = $('#PhoneNoM').val();
        console.log($('#PhoneNoM').val());
        console.log(PhoneM);
        if (PhoneM != null && PhoneM != '') {
            if (BPhoneValidMainLayout()) {
                $('#spanBPOTPM').html('');
                $('#VerifyotppM').show();
                $('#timerblockM').show();
                $('#otpbtnM').hide();
                $('#spanPhoneNoMFailed').html('');
                $('#spanPhoneNoMSuccess').html('');
                $('#VerifiedOTPM').val('');
                SendPhoneBOTPM();
            }
        }
        else {
            alert('Enter Mobile Number')
        }
    }

    function VerifyBLoginOTPM() {
        if (BPhoneValidMainLayout()) {
            if (VerifyBPhoneOTPM()) {
                return true;
            }
            else {
                return false;
            }
        }
        else {
            return false;
        }
    }

    function SendPhoneBOTPM() {
        var PhoneM = $('#PhoneNoM').val();
        if (PhoneM != null && PhoneM != '') {
            $.ajax({
                type: "POST",
                url: '/Users/SmsService/SendOtp', // the URL of the controller action method
                data: { PhoneNo: PhoneM }, // optional data
                datatype: "JSON",
                async: false,
                success: function (result) {
                    if (result.status === "success") {
                        /*$('#OTP').val('');*/
                        $('#spanPhoneNoMSuccess').html('OTP Sent to Mobile No.');
                        $('#otpbtnM').hide();
                        $('#VerifiedOTPM').val('');
                        $('#PhoneVerifiedM').val('No');
                        $('#VerifyotppM').show();
                        $('#timerblockM').show();
                        $('#PhoneNoM').attr('readonly', 'readonly');
                        $('#SubmitVBTNM').show();
                        PBSetTimerM();
                        //$('#vMainbutton').show();
                        //$('#valfabutton').hide();
                    }
                    else {
                        $('#spanPhoneNoMFailed').html('Failed to send OTP.');

                        $('#VerifyotppM').hide();
                        $('#timerblockM').hide();
                        $('#otpbtnM').show();
                        $('#PhoneNoM').attr('readonly', 'readonly');
                        PBSetTimerM();
                    }
                }
            });
        }
    }

    var px = null;

    function PBSetTimerM() {
        var now1 = new Date(); // get "now"
        now1.setMinutes(now1.getMinutes() + 15);
        // Set the date we're counting down to
        var countDownDate = new Date(now1).getTime();
        clearInterval(px);
        // Update the count down every 1 second
        px = setInterval(function () {

            // Get todays date and time
            var now = new Date().getTime();

            // Find the distance between now and the count down date
            var distance = countDownDate - now;

            // Time calculations for days, hours, minutes and seconds
            var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            var seconds = Math.floor((distance % (1000 * 60)) / 1000);

            // Output the result in an element with id="demo"
            $('#otpptimerM').html("OTP valid upto " + minutes + ":" + seconds);

            // If the count down is over, write some text
            if (distance < 0) {
                clearInterval(px);
                //$('#otpptimerM').html('<a onclick="SendPhoneBOTPM();">Resend OTP</a>');
                $('#otpptimerM').html('OTP Expired');
            }
        }, 1000);
    }

    function VerifyBPhoneOTPM() {
        var returnval = false;
        var OTP = $('#VOTPM').val();
        if (OTP != null && OTP != '') {
            $.ajax({
                type: "POST",
                url: '/Users/SmsService/VerifyPhoneOTP', // the URL of the controller action method
                data: { OTP: OTP }, // optional data
                datatype: "JSON",
                async: false,
                success: function (result) {
                    if (result.ok) {
                        clearInterval(px);
                        $('#spanBPOTPM').html('');
                        $('#otpptimerM').html('');
                        $('#otpptimerM1').html('Phone No. Verified').addClass('green-t').removeClass('red-t');
                        $('#VerifiedOTPM').val(OTP);
                        $('#PhoneVerifiedM').val('Yes');
                        $('#SubmitVBTNM').hide();
                        returnval = true;
                    }
                    else {
                        //clearInterval(px);
                        $('#spanBPOTPM').html('Invalid OTP').show();
                        //$('#otpptimerM').html('<a onclick="SendPhoneBOTPM();">Resend OTP</a>').removeClass('green-t').addClass('red-t');
                        $('#VerifiedOTPM').val('');
                        $('#PhoneVerifiedM').val('No');
                        returnval = false;
                    }
                }
            });
        }
        return returnval;
    }
