    function BPhoneValidMainLayout() {
        // Validate Phone Number
        if ($.trim($('#PhoneNoM').val()) === '') {
            $('#PhoneNoM').focus().addClass('redborder');
            $('#spanPhoneNoM').show().html('Phone Number Required');
            return false;
        } else if (!/^\d{10}$/.test($('#PhoneNoM').val())) { // Ensure the phone number has exactly 10 digits
            $('#PhoneNoM').focus().addClass('redborder');
            $('#spanPhoneNoM').show().html('Invalid Phone Number');
            return false;
        } else {
            $('#PhoneNoM').removeClass('redborder');
            $('#spanPhoneNoM').hide();
        }

        return true;
    }

    function SendBLoginOTPM() {
        console.log('entered Mainlayout');
        var PhoneM = $('#PhoneNoM').val();
        console.log($('#PhoneNoM').val());
        console.log(PhoneM);
        if (PhoneM != null && PhoneM != '') {
            if (BPhoneValidMainLayout()) {
                $('#spanBPOTPM').html('');
                $('#VerifyotppM').show();
