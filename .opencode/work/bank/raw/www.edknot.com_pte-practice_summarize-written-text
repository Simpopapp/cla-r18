ned\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[\"$L5\",null,[\"$\",\"$L6\",null,{\"children\":[\"$\",\"$7\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@8\"}]}]]}],{},null,false,null]},null,false,\"$9\"]},null,false,\"$9\"]},null,false,null]},null,false,\"$9\"],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$La\",null,{\"children\":\"$Lb\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$Lc\",null,{\"children\":[\"$\",\"$7\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Ld\"}]}]}],null]}],false]],\"m\":\"$undefined\",\"G\":[\"$e\",[]],\"S\":true,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"ipceFUOZ25PywKvmOTByg\"}\n9:C\nf:T6d27,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://www.edknot.com/pte-practice/summarize-written-text#webpage\",\"url\":\"https://www.edknot.com/pte-practice/summarize-written-text\",\"name\":\"PTE Summarize Written Text practice: 12 passages with answers\",\"isPartOf\":{\"@id\":\"https://www.edknot.com/#website\"},\"description\":\"Twelve real Summarize Written Text passages from the EdKnot bank, each with a one-sentence model summary that scores full marks on EdKnot scoring. Write your summary in the practice player and get Content, Form, Grammar and Vocabulary scores back.\",\"dateModified\":\"2026-10-06T23:20:12+10:00\",\"breadcrumb\":{\"@id\":\"https://www.edknot.com/pte-practice/summarize-written-text#breadcrumb\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.edknot.com/pte-practice/summarize-written-text#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"item\":\"https://www.edknot.com/\",\"name\":\"Home\",\"position\":1},{\"@type\":\"ListItem\",\"item\":\"https://www.edknot.com/pte-practice\",\"name\":\"Practice questions\",\"position\":2},{\"@type\":\"ListItem\",\"item\":\"https://www.edknot.com/pte-practice/summarize-written-text\",\"name\":\"Summarize Written Text practice\",\"position\":3}]},{\"@type\":[\"Quiz\",\"LearningResource\"],\"@id\":\"https://www.edknot.com/pte-practice/summarize-written-text#quiz\",\"about\":{\"@type\":\"Thing\",\"name\":\"PTE Summarize Written Text\"},\"educationalUse\":\"practice\",\"hasPart\":[{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Autism Prevalence And Causes\",\"position\":1,\"text\":\"Autism is a disorder characterized by impairments in communication, social interaction, and repetitive behaviors. Over the past 40 years, the measured prevalence of autism has multiplied roughly 10-fold. While progress has been made in understanding some of the factors associated with increased risk and rising prevalence, no one knows with certainty what causes autism or what caused autism prevalence to rise so precipitously. There is, however, a growing awareness among scholars that focusing solely on individual risk factors such as exposure toxicants, prenatal complications, or parental education is insufficient to explain why autism prevalence rates have increased so stunningly. Social and institutional processes likely play an important role. For example, changes in diagnostic criteria and an influx of resources dedicated to autism diagnosis may be critical to understanding why prevalence rates have risen. Increased awareness and social influence have been implicated in the rise of autism and a variety of comparable disorders, where social processes mimic the effects of contagion. Studies have examined the contribution of changes in diagnostic criteria and diagnostic substitution to rising autism prevalence rates, but the importance of institutional factors, resources for diagnosis, and greater awareness have not been systematically assessed. The sociological literature on health and inequality, however, provides substantial motivation for exploring how individual- and community-level effects operate to shape the likelihood of an autism diagnosis.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Autism prevalence has risen roughly tenfold over the past 40 years for reasons that remain uncertain, and since individual risk factors alone cannot explain this surge, researchers increasingly point to social and institutional processes, such as changing diagnostic criteria, growing diagnostic resources, and awareness spreading like contagion, though these remain less systematically studied than diagnostic substitution, prompting sociologists of health and inequality to examine how individual- and community-level effects shape diagnosis likelihood.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Plant Animal Ecosystem Importance\",\"position\":2,\"text\":\"Wherever we travel on the planet, there are beautiful plants, flowers, and animals that capture our gaze. They are two extremely vital components of any ecosystem. Of all the living beings on the planet, the ones we encounter most often are the plant life and the animal life. Besides these two, additional life forms thrive on earth, but are more difficult to see with the unaided eye. This is why the flora and fauna, i.e., plant and wildlife of the earth, are captivating to observe and study. Flora and fauna are terms originating from Latin. Flora in Latin signifies the goddess of the flower. Flora is also derived from the word floral, which means pertaining to flowers. Therefore flora is a collection of native plants in an ecosystem of a geographic region. The origin of the word fauna is somewhat veiled in mystery. According to Roman mythology, Fauna denotes the goddess of fertility. Fauna is occasionally referred to as Fauns, meaning forest spirits. By definition, fauna is a collection of native animals of any geographic region. So, the term flora and fauna was created by biologists to denote a collection of plant and animal species in a specific geographic location. This is why you encounter phrases like flora and fauna of India, flora and fauna of Indonesia, and so forth.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Plants and animals, the most visible and captivating of an ecosystem's vital components even though other less visible life forms also exist, are termed flora and fauna—words derived from the Roman goddesses of flowers and fertility respectively—and biologists use these terms together to denote the native plant and animal species of a specific geographic region, as in phrases like \\\"the flora and fauna of India.\\\"\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Audiovisual Political Power\",\"position\":3,\"text\":\"The power of audiovisuals has been manifested and exploited politically, socially, and economically throughout history. Leaders such as Adolf Hitler, for example, successfully used films as propaganda tools during World War II. Unfortunate facts like these show the raw power of film has even caused revolutions. As technology keeps growing, political and economic leaders have utilized cinema in changing and shaping people’s outlooks either for their own benefit or for the benefit of the people. Quality translations are also readily available and extremely affordable for everyone these days, which makes it easy for filmmakers to reach their target audiences from all corners of the world in their mother tongue. A good movie can entertain, educate, and inspire the viewer in many ways. Think of the impact that songs have on people, for example. They can make us think. They can make us compassionate. They can inspire us to help others and to do good to and for humanity. Romantic movies, on the other hand, can remind us why love is important and why it is worth fighting for. They make us cry and laugh at our own romantic flaws. Crime and action TV shows also warn us about the dangers of criminal activities, terrorism, and war. Every movie is set and developed in a particular culture. Movies are an integral part of us; they mirror what we believe and how we coexist as people. It is easier to see our concerns, attitudes, flaws and strengths in films than it is to decipher them from our daily interactions. When our prevalent beliefs and ideologies are challenged in films, we are sometimes able to interrogate ourselves and embrace change.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Audiovisual media have long been exploited for political, social and economic influence—from Hitler's wartime propaganda films to affordable translated cinema reaching global audiences—because movies entertain, educate and inspire by mirroring a culture's beliefs and flaws, so when films challenge our assumptions we are prompted to reflect and embrace change.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Solar Cell Technology Breakthrough\",\"position\":4,\"text\":\"Recent research has led to a significant breakthrough in solar cell technology, offering the potential to revolutionize the way we harness and utilize solar energy. This innovation promises to make solar power more efficient and accessible than ever before. Traditional solar cells, known as photovoltaic cells, have limitations when it comes to capturing sunlight and converting it into electricity. A major challenge has been maximizing the absorption of sunlight across a broad spectrum of wavelengths. However, researchers have now developed a new type of solar cell that addresses this issue. The breakthrough involves the use of perovskite solar cells, a type of solar technology that has gained attention for its high efficiency and low production costs. Perovskite solar cells have the unique ability to absorb a wider range of light wavelengths, making them more effective in converting sunlight into electricity. Furthermore, perovskite solar cells can be manufactured using simpler and more cost-effective methods than traditional silicon solar cells. This means that solar panels incorporating this technology can potentially be produced at a lower cost, making solar energy more affordable and accessible to a broader range of people. Additionally, the flexibility and versatility of perovskite solar cells open up new possibilities for integration into various applications, such as wearable technology, building-integrated photovoltaics, and portable electronic devices. This breakthrough in solar cell technology not only holds promise for a more sustainable and eco-friendly future but also highlights the ongoing advancements in renewable energy. As researchers continue to refine and scale up perovskite solar cell production, we may soon see a significant increase in the adoption of solar energy as a clean and efficient power source.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A breakthrough in perovskite solar cells, which overcome traditional photovoltaic cells' limited absorption of sunlight by capturing a wider range of wavelengths, promises to revolutionize solar energy through simpler, cheaper manufacturing than silicon cells and flexible designs suited to wearables, building-integrated photovoltaics, and portable devices, potentially driving a significant rise in solar energy adoption as production is scaled up.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Panama Canal Expansion Effects\",\"position\":5,\"text\":\"The Panama Canal expansion, completed in 2016, was one of the largest infrastructure projects in modern history. The new set of locks allowed the transit of Neo-Panamax vessels, which are nearly three times the capacity of the older Panamax ships. This change had profound effects on global shipping routes. Previously, many goods from Asia destined for the U.S. East Coast were offloaded at West Coast ports and transported by rail. With the expansion, direct all-water routes became economically viable, leading to a shift in cargo flows. Ports on the U.S. East Coast, such as Savannah and Charleston, invested heavily in deepening harbors and upgrading cranes to handle the larger ships. Meanwhile, some West Coast ports experienced a temporary decline in market share. The expansion also impacted other regions: ports in Latin America and the Caribbean vied to become transshipment hubs. While the project was initially controversial due to cost overruns and environmental concerns, its completion has reshaped maritime trade patterns and reinforced the canal's strategic importance.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Panama Canal's 2016 expansion, which let far larger Neo-Panamax ships pass through, redirected Asia-to-US-East-Coast cargo from West Coast rail routes to direct all-water shipping, prompting East Coast ports like Savannah and Charleston to deepen harbors while West Coast ports lost market share and Caribbean and Latin American ports competed as transshipment hubs, ultimately reshaping global trade patterns despite earlier cost and environmental controversies.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Financial Investment Basics\",\"position\":6,\"text\":\"Financial investment is a crucial aspect of personal finance that allows individuals to grow their wealth over time. While it may seem complex, understanding the essentials of investment is essential for making informed decisions and achieving financial goals. Diversification is a fundamental principle of investment. Spreading your investments across different asset classes, such as stocks, bonds, real estate, and commodities, helps reduce risk. A diversified portfolio can cushion losses in one area with gains in another, providing stability. Risk tolerance is another key consideration. Assessing your risk tolerance helps determine the right investment strategy for you. Generally, younger investors with a longer investment horizon can afford to take on more risk, while older investors may prioritize capital preservation. Time horizon plays a significant role in investment decisions. Short-term goals, like buying a car, may be best suited for low-risk, liquid investments, while long-term goals, such as retirement, can benefit from higher-risk, higher-reward options that have time to recover from market fluctuations. Research and education are critical for successful investing. Stay informed about financial markets, investment products, and economic trends. Consider seeking advice from financial advisors or using online resources to expand your knowledge. Costs matter in investing. Be aware of fees associated with investments, such as management fees, commissions, and taxes. Minimizing these costs can significantly impact your overall returns. Finally, it's crucial to have a clear investment strategy and stick to it. Avoid emotional reactions to market volatility, as impulsive decisions can lead to losses. Patience and discipline are key to achieving long-term financial success. In conclusion, financial investment is a powerful tool for building wealth and achieving financial goals. By diversifying, understanding your risk tolerance, considering your time horizon, staying informed, managing costs, and adhering to a well-defined strategy, you can make the most of your investment journey.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Successful financial investing depends on diversifying across asset classes to reduce risk, matching risk tolerance and time horizon—favoring low-risk, liquid options for short-term goals and higher-risk, higher-reward ones for long-term goals like retirement—staying informed through research and financial advice, minimizing costs such as fees and taxes, and maintaining a disciplined, unemotional strategy, all of which together build wealth and achieve long-term financial goals.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Martian Atmosphere And Geology\",\"position\":7,\"text\":\"The main force behind contemporary Martian geology is its atmosphere, which is primarily composed of carbon dioxide, nitrogen, and argon. By Earth measures, the air is absurdly thin; air pressure at the summit of Mount Everest is roughly 50 times greater than it is at the Martian surface. Despite the thin air, Martian winds can blow up to 60 miles per hour, stirring up dust that powers enormous dust storms and vast fields of alien sand dunes. Once upon a time, however, wind and water moved across the red planet. Robotic rovers have uncovered clear evidence that billions of years ago, lakes and rivers of liquid water flowed across the red planet's surface. This implies that at some point in the far-off past, Mars's atmosphere was sufficiently thick and retained enough heat for water to stay liquid on the red planet's surface. Not so today: although water ice is plentiful beneath the Martian surface and in its polar ice caps, there are no large bodies of liquid water on the surface there today. Mars also lacks an active plate tectonic system, the geologic motor that drives our dynamic Earth, and is also missing a planetary magnetic field. The absence of this protective shield makes it simpler for the sun's high-energy particles to strip away the red planet's atmosphere, which may help clarify why Mars's atmosphere is now so thin. But in the ancient past, Mars appears to have had an inner dynamo driving a planet-wide magnetic field. What turned off the Martian dynamo? Scientists are still working to determine.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Mars's thin atmosphere—mostly carbon dioxide, nitrogen, and argon, with surface pressure some 50 times lower than atop Mount Everest—now drives 60-mph winds that fuel dust storms, yet rovers show billions of years ago a thicker, warmer atmosphere let liquid water carve lakes and rivers before Mars, lacking plate tectonics and a magnetic field, lost much air to solar particles, leaving scientists unsure what shut down its ancient protective dynamo.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Cartography History Grid System\",\"position\":8,\"text\":\"The history of cartography is a story of human ingenuity and the desire to understand our place in the world. Early maps were often symbolic representations, mixing geographical knowledge with mythology and religious beliefs. The ancient Greeks, particularly Ptolemy, made significant strides by introducing concepts of latitude and longitude, creating a grid system that allowed for more accurate positioning. However, it was not until the Age of Exploration that mapmaking underwent a dramatic transformation. Explorers returning from voyages to the Americas, Africa, and Asia brought back detailed coastlines and new lands, forcing cartographers to constantly update their charts. A major breakthrough came in 1569 when Gerardus Mercator created a world map using a new projection. This cylindrical map projection was revolutionary because it preserved local angles and shapes, making it invaluable for nautical navigation. Sailors could plot straight lines of constant bearing, known as rhumb lines, which greatly simplified long-distance sea travel. Despite its distortion of area at high latitudes, making Greenland appear much larger than Africa, the Mercator projection became the standard for navigation and remains widely used in classrooms and atlases today, illustrating how a practical solution to a navigational problem can have a lasting impact on how we visualize the world.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cartography progressed from mythology-infused ancient maps through Ptolemy's latitude-longitude grid and the Age of Exploration's newly charted coastlines to Gerardus Mercator's 1569 cylindrical projection, which preserved angles for navigational rhumb lines and, despite exaggerating high-latitude landmasses like Greenland, remains a standard reference today.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Genes Influence Job Choice\",\"position\":9,\"text\":\"Twin studies have been very useful in giving us information about whether our genes or our environment makes us who we are. A surprising result is the way that genes influence our work. At a basic level, our genes affect how we look and so they influence whether we can become a basketball player or a supermodel, for example. However, there is evidence that genes influence our job choice in much greater ways. Research shows that identical twins choose more similar jobs than non-identical twins. In fact, identical twins who have grown up apart choose more similar jobs than non-identical twins who have grown up together. Studies also show that identical twins suggests that our genes affect both the satisfaction that comes from doing a job and satisfaction that comes from working conditions such as a person's pay or their manager. So what does this mean? It means that from birth, you are more likely to prefer one occupation to another and find certain jobs more satisfying than others. However, genes are not the only factor. Other things in your life, such as family background and education, will also be influential in your career choices.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Twin studies show that genes, beyond shaping appearance, surprisingly influence job choice—since identical twins raised apart pick more similar careers than fraternal twins raised together and share similar satisfaction with both the work itself and conditions like pay or management—though family background and education also shape career decisions.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Ecology Climatology Study\",\"position\":10,\"text\":\"Ecology is the study of interactions of organisms among themselves and with their environment. It seeks to understand patterns in nature (e.g., the spatial and temporal distribution of organisms) and the processes governing those patterns. Climatology is the study of the physical state of the atmosphere – its instantaneous state or weather, its seasonal-to-interannual variability, its long-term average condition or climate, and how climate changes over time. These two fields of scientific study are distinctly different. Ecology is a discipline within the biological sciences and has as its core the principle of natural selection. Climatology is a discipline within the geophysical sciences based on applied physics and fluid dynamics. Both, however, share a common history. The origin of these sciences is attributed to Aristotle and Theophrastus and their books Meteorological and Enquiry into Plants, respectively, but their modern beginnings trace back to natural history and plant geography. Seventeenth, eighteenth, and nineteenth century naturalists and geographers saw changes in vegetation as they explored new regions and laid the foundation for the development of ecology and climatology as they sought explanations for these geographic patterns. Alexander von Humboldt, in the early 1800s, observed that widely separated regions have structurally and functionally similar vegetation if their climates are similar. Alphonse de Candolle hypothesized that latitudinal zones of tropical, temperate, and arctic vegetation are caused by temperature and in 1874 proposed formal vegetation zones with associated temperature limits.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ecology studies organisms' interactions with each other and their environment, while climatology studies the atmosphere's weather, variability and long-term climate; though distinct—ecology rooted in biology, climatology in geophysics—both trace back to Aristotle and Theophrastus and grew from natural history and plant geography, as shown when Humboldt's early-1800s observation that similar climates produce similar vegetation led de Candolle to propose, in 1874, formal temperature-based tropical, temperate and arctic vegetation zones.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"The Gig Economy and Worker Classification\",\"position\":11,\"text\":\"The term 'gig economy' has entered common parlance to describe a labor market where temporary, flexible jobs are commonplace, and companies tend to hire independent contractors and freelancers instead of full-time employees. This model, facilitated by digital platforms that connect workers directly with consumers, offers workers the ability to set their own hours and choose their tasks. Proponents highlight the autonomy and work-life balance it can provide. Conversely, critics argue that the gig economy often shifts the risks of business—such as income instability, lack of paid leave, and absence of health insurance—onto the individual worker. Furthermore, the classification of gig workers as independent contractors rather than employees has sparked legal debates about the applicability of minimum wage laws, overtime pay, and collective bargaining rights.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The gig economy, in which digital platforms let companies hire independent contractors for flexible, short-term work instead of full-time employees, grants workers autonomy and better work-life balance but shifts business risks such as unstable income and the absence of paid leave and health insurance onto them, fueling legal disputes over whether contractors should receive minimum wage, overtime pay, and collective bargaining rights.\"}},{\"@type\":\"Question\",\"eduQuestionType\":\"Flashcard\",\"name\":\"Reading Aloud Improves Writing\",\"position\":12,\"text\":\"It might seem a little eccentric, but reviewing your work by reading it aloud can help to identify the woolliest areas. This works best if you perform your reading in a theatrical way, pausing at the commas and ends of sentences. If you run out of breath during a sentence, it is probably too long. You ought to be able to convert your writing into a speech in this way if it sounds too stilted and convoluted, perhaps you could rework these parts until they sound fluid. It is unlikely that your reader will be fooled by the idea that long words make you sound clever. Cluttering a sentence with too many complicated words can prevent its meaning from being understood at all. A short word is always preferable to a long one. Why should anyone choose the word erroneous over the word wrong in an essay? Usually, writers who employ more obscure words are trying to sound impressive but can appear pretentious. Direct words enable you to control what you are saying, and are not necessarily babyish, but the most appropriate ones for the job. When you read your writing aloud, you will notice that the key stress comes at the end of your sentence. It is, therefore, most effective to end with a short and emphatic word to secure your point. Try to resist the impulse to waffle at the end of your sentence by trailing off into qualifying clauses. It might be worth relocating the clause to the beginning of the sentence or losing it altogether if you feel that it adds little to its meaning. Your sentences might be the most grammatically perfect in the world, but still, cause your writing to sound wrong if you have misjudged its tone. A colloquial style, which uses slang and exclamations, is an inappropriately chatty tone for an essay. However, style can be equally jarring if your vocabulary is too formal or ambitious for its context. It is much more impressive to make complicated points using simple language and grammar.\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Reading your writing aloud in a theatrical way helps spot overly long or convoluted sentences and clunky, over-complicated word choices that obscure meaning, favoring short, direct words and ending sentences on an emphatic point rather than trailing off into qualifying clauses, while also revealing whether the tone is mismatched—too colloquial or too formal—since expressing complex ideas in simple language is ultimately most effective.\"}}],\"inLanguage\":\"en\",\"isPartOf\":{\"@id\":\"https://www.edknot.com/#website\"},\"name\":\"PTE Summarize Written Text practice: 12 passages with answers\",\"numberOfItems\":12,\"description\":\"Twelve real Summarize Written Text passages from the EdKnot bank, each with a one-sentence model summary that scores full marks on EdKnot scoring. Write your summary in the practice player and get Content, Form, Grammar and Vocabulary scores back.\"},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One sentence of 5 to 75 words. A full stop in the middle, or more than 75 words, scores zero for Form and nothing else is marked.\"},\"name\":\"How long should the summary be?\"},{\"@type\":\"Question\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Key terms, yes; whole clauses, no. Content is scored on whether the main ideas are present, Vocabulary on how you express them.\"},\"name\":\"Should I copy phrases from the passage?\"},{\"@type\":\"Question\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ten minutes per item, including reading. Spend two reading, five writing and three checking the one-sentence rule and the spelling.\"},\"name\":\"How much time do I get?\"}]}]}5:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"},\"type\":\"application/ld+json\"}],\"$L10\",\"$L11\",\"$L12\",\"$L13\"]\n