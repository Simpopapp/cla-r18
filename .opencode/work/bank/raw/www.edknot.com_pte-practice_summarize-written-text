"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center justify-center gap-1.5 border leading-none whitespace-nowrap\",\"data-accent\":\"$undefined\",\"data-tone\":\"success\",\"style\":{\"background\":\"#ecfdf5\",\"borderColor\":\"#6ee7b7\",\"borderRadius\":6,\"boxShadow\":\"$undefined\",\"color\":\"#065f46\",\"fontSize\":\"0.72rem\",\"fontWeight\":700,\"height\":22,\"letterSpacing\":\"0.01em\",\"paddingLeft\":6,\"paddingRight\":6},\"children\":[\"AI \",\"9/9\"]}]]}]]}],[null,[\"$\",\"p\",null,{\"className\":\"mt-3.5 text-[1.02rem] leading-[1.75] whitespace-pre-line text-ink border-l-[3px] border-aqua pl-4\",\"children\":\"The term 'gig economy' has entered common parlance to describe a labor market where temporary, flexible jobs are commonplace, and companies tend to hire independent contractors and freelancers instead of full-time employees. This model, facilitated by digital platforms that connect workers directly with consumers, offers workers the ability to set their own hours and choose their tasks. Proponents highlight the autonomy and work-life balance it can provide. Conversely, critics argue that the gig economy often shifts the risks of business—such as income instability, lack of paid leave, and absence of health insurance—onto the individual worker. Furthermore, the classification of gig workers as independent contractors rather than employees has sparked legal debates about the applicability of minimum wage laws, overtime pay, and collective bargaining rights.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3.5\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-xl bg-aqua-soft px-[18px] py-4 max-md:px-3.5 max-md:py-3.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-heading mb-2 text-[0.69rem] font-extrabold tracking-[0.12em] text-ink-strong uppercase\",\"children\":\"Model summary · 62 words\"}],[\"$\",\"p\",null,{\"className\":\"font-mono text-[0.84rem] leading-[1.9] text-ink max-md:text-[0.76rem] max-md:leading-[1.75]\",\